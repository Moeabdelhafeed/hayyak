{
    "info": {
        "_postman_id": "hayyak-public-api-clean-2026-05-23",
        "name": "Hayyak Public API (Clean)",
        "description": "Public-facing API endpoints. Hidden modules excluded (tenants, wishlist, favorites, auth). All requests carry X-API-TOKEN in the header.\n\n**Setup**\n1. Set the `base_url` and `x_api_token` collection variables (top right → Variables).\n2. `x_api_token` must match a row in the `api_tokens` table (admin → Settings → API Tokens).\n3. `locale` is optional — pass `en` or `ar` to change the active language for translated responses.",
        "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
    },
    "variable": [
        { "key": "base_url", "value": "https://hayyak-cms.dottechjo.com/api", "type": "string" },
        {
            "key": "x_api_token",
            "value": "d3babb58f6cb937c004d43d654f542ec7cf55eacc20e57308d76199b0529cd7b549bc7f2f08ae979da6307de81d40a937737f4527f7b358d361d178896f169a5",
            "type": "string"
        },
        { "key": "locale", "value": "en", "type": "string" }
    ],
    "auth": { "type": "noauth" },
    "event": [
        {
            "listen": "prerequest",
            "script": {
                "type": "text/javascript",
                "exec": [
                    "// Apply X-API-TOKEN + locale to every request automatically.",
                    "pm.request.headers.upsert({ key: 'X-API-TOKEN', value: pm.collectionVariables.get('x_api_token') });",
                    "pm.request.headers.upsert({ key: 'Accept', value: 'application/json' });",
                    "pm.request.headers.upsert({ key: 'Accept-Language', value: pm.collectionVariables.get('locale') || 'en' });"
                ]
            }
        }
    ],
    "item": [
