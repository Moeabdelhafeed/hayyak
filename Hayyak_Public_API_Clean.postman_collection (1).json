        {
            "name": "Leads (public submit)",
            "description": "Public, anonymous lead submission. No auth required. Each request needs at least `first_name`, `last_name`, and one of `email` or `phone`. See `form_type` enum: buy | sell | rent | lease_out | property_management | valuation | other.",
            "item": [
                {
                    "name": "Submit lead — buy",
                    "request": {
                        "method": "POST",
                        "header": [{ "key": "Content-Type", "value": "application/json" }],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n    \"first_name\": \"Mariam\",\n    \"last_name\": \"Hassan\",\n    \"email\": \"mariam.hassan@example.com\",\n    \"phone\": \"+962790000001\",\n    \"country_code\": \"+962\",\n    \"form_type\": \"buy\",\n    \"lead_type\": \"Sales\",\n    \"source\": \"Website\",\n    \"property_id\": 1,\n    \"unit_id\": 1,\n    \"originating_url\": \"https://hayyak-cms.dottechjo.com/properties/1\",\n    \"message\": \"Interested in this unit, please contact me to arrange a viewing.\",\n    \"budget_min\": 80000,\n    \"budget_max\": 150000,\n    \"bedrooms\": 3,\n    \"baths\": 2,\n    \"size_sqft\": 1500,\n    \"location_text\": \"Amman, Abdoun\"\n}"
                        },
                        "url": { "raw": "{{base_url}}/leads", "host": ["{{base_url}}"], "path": ["leads"] }
                    }
                },
                {
                    "name": "Submit lead — sell",
                    "request": {
                        "method": "POST",
                        "header": [{ "key": "Content-Type", "value": "application/json" }],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n    \"first_name\": \"Omar\",\n    \"last_name\": \"Khalil\",\n    \"email\": \"omar.khalil@example.com\",\n    \"phone\": \"+962790000002\",\n    \"country_code\": \"+962\",\n    \"form_type\": \"sell\",\n    \"lead_type\": \"Sales\",\n    \"source\": \"Website\",\n    \"originating_url\": \"https://hayyak-cms.dottechjo.com/sell\",\n    \"description\": \"4-bed villa in Abdoun, build area 350 sqm, plot 600 sqm. Need valuation and listing.\",\n    \"value\": 750000,\n    \"size_sqft\": 3767,\n    \"bedrooms\": 4,\n    \"baths\": 4,\n    \"floor\": 0,\n    \"private_garden\": true,\n    \"location_text\": \"Amman, Abdoun\"\n}"
                        },
                        "url": { "raw": "{{base_url}}/leads", "host": ["{{base_url}}"], "path": ["leads"] }
                    }
                },
                {
                    "name": "Submit lead — rent",
                    "request": {
                        "method": "POST",
                        "header": [{ "key": "Content-Type", "value": "application/json" }],
