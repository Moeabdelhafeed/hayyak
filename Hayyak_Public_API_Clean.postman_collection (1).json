        {
            "name": "Translations",
            "item": [
                {
                    "name": "Get translations",
                    "request": {
                        "method": "GET",
                        "header": [],
                        "url": {
                            "raw": "{{base_url}}/general/translations?group=cms&lang=all",
                            "host": ["{{base_url}}"],
                            "path": ["general", "translations"],
                            "query": [
                                { "key": "group", "value": "cms", "description": "Translation group (default: cms)" },
                                {
                                    "key": "lang",
                                    "value": "all",
                                    "description": "'all' returns every active locale keyed by code; or pass a specific locale (en, ar)."
                                }
                            ]
                        }
                    }
                },
                {
                    "name": "Send translations",
                    "request": {
                        "method": "POST",
                        "header": [
                            { "key": "Content-Type", "value": "application/json" },
                            { "key": "X-Translation-Group", "value": "cms", "description": "Target translation group (overrides ?group=)." },
                            { "key": "X-Translation-Locale", "value": "en", "description": "Target locale — must match an active language." }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n    \"home\": \"Home\",\n    \"about\": \"About Us\",\n    \"contact\": \"Contact\",\n    \"login\": \"Sign In\"\n}"
                        },
                        "url": { "raw": "{{base_url}}/general/translations", "host": ["{{base_url}}"], "path": ["general", "translations"] },
                        "description": "Upsert per-key translations. Group + locale resolution order: header → query → body. Accepts a flat `{key: text}` map or a wrapped `{group, locale, translations: {...}}` shape."
                    }
                },
                {
                    "name": "Clear translations",
                    "request": {
                        "method": "DELETE",
                        "header": [
                            { "key": "X-Translation-Group", "value": "cms" },
                            { "key": "X-Translation-Locale", "value": "en", "description": "Pass 'all' to wipe every locale; pass a code to scope." }
                        ],
                        "url": { "raw": "{{base_url}}/general/translations", "host": ["{{base_url}}"], "path": ["general", "translations"] },
                        "description": "Wipe language_lines rows scoped by group + locale. Use group=all or locale=all to widen the scope."
                    }
                }
            ]
        },
